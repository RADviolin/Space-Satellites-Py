
import matplotlib.animation as animation
import math
import matplotlib.pyplot as plt

# Satellite information
orbital_radius = 10000
angle = 97

satellite_name = "SKZ"

# Calculate satellite position
x = orbital_radius * math.cos(math.radians(angle))
y = orbital_radius * math.sin(math.radians(angle))

# Draw Earth
earth = plt.Circle((0, 0), 6371, color="blue", label="Earth")

fig, (ax, info_ax) = plt.subplots(
    1, 2, figsize=(12, 6),
    gridspec_kw={"width_ratios": [2, 1]}
)

ax.add_patch(earth)

# Draw satellite orbit
orbit = plt.Circle((0, 0), orbital_radius,
                   fill=False, color="gray",
                    linestyle="--")

ax.add_patch(orbit)

# Draw satellite
satellite, = ax.plot([], [], "ro", markersize=8, label="Satellite")

def update(frame):
    angle = frame
    x = orbital_radius * math.cos(math.radians(angle))
    y = orbital_radius * math.sin(math.radians(angle))
    altitude = orbital_radius - 6371

    info_ax.clear()
    info_ax.axis("off")

    info_ax.text(0, 0.9, "SATELLITE STATUS", fontsize=14, weight="bold")
    info_ax.text(0, 0.75, f"Name: {satellite_name}")
    info_ax.text(0, 0.65, f"Orbital Radius: {orbital_radius} km")
    info_ax.text(0, 0.55, f"Altitude: {altitude} km")
    info_ax.text(0, 0.45, f"Angle: {angle} degrees")
    info_ax.text(0, 0.35, f"X Position: {x:.1f} km")
    info_ax.text(0, 0.25, f"Y Position: {y:.1f} km")
    satellite.set_data([x], [y])

    return satellite,

ani = animation.FuncAnimation(
    fig,
    update,
    frames=range(360),
    interval=14,
    blit=True
)

# Set graph appearance
ax.set_xlim(-10000, 10000)
ax.set_ylim(-10000, 10000)
ax.set_aspect("equal")

ax.set_title("SpaceSatellites - Orbital Tracking")
ax.set_xlabel("X Position (km)")
ax.set_ylabel("Y Position (km)")
ax.legend()
ax.grid()

plt.show()
